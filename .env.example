# Copy this file to .env and fill in your own values before running docker-compose.
# Never commit .env to version control.

# PostgreSQL password (used by both TimescaleDB and the exchange service)
POSTGRES_PASSWORD=change_me_use_a_strong_password

# Admin token — protects all /admin/* endpoints (set a long random hex string)
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change_me_use_a_strong_random_token
